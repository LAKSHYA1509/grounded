# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- model provider ---------------------------------------------------
# Default is Google Gemini: free tier, no credit card, does not expire.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=replace-me

CHAT_MODEL=google_genai:gemini-2.5-flash-lite
EMBEDDING_MODEL=google_genai:gemini-embedding-001

# To use OpenAI instead, set OPENAI_API_KEY and change the two lines above
# to openai:gpt-4o-mini / openai:text-embedding-3-small. No code changes.
# OPENAI_API_KEY=sk-...

# Vector size. Leave at 0 to measure it from the model at startup, which
# means config can never disagree with reality. Set it only to skip that
# one extra call on cold start.
EMBEDDING_DIM=0

# --- vector store -----------------------------------------------------
# Leave QDRANT_URL empty to run in-memory: no server, no setup. That is how
# the tests run and how a fresh clone works with nothing but a model key.
# Set it to a Qdrant Cloud cluster URL for anything that must persist.
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION=grounded

# --- access control ---------------------------------------------------
# If set, every request except /health needs this as the X-API-Key header.
# Leave empty locally. ALWAYS set it on a public deployment - /ask spends
# quota on the model key above.
API_KEY=

# --- chunking / retrieval ---------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4

# --- server -----------------------------------------------------------
# Most platforms inject their own $PORT. 7860 is only the fallback.
PORT=7860
