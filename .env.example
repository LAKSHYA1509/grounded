# Copy to .env and fill in. .env is gitignored — never commit real keys.

OPENAI_API_KEY=sk-replace-me

# provider:model. Swap the provider and nothing else in the code changes.
CHAT_MODEL=openai:gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Chunking. Overlap stops an idea being cut in half at a boundary.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# How many chunks to retrieve per question.
RETRIEVAL_K=4

PERSIST_DIR=./.chroma
COLLECTION=grounded
