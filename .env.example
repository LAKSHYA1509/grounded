# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- model provider ---------------------------------------------------
OPENAI_API_KEY=sk-replace-me

# provider:model. Swap the provider and nothing else in the code changes.
CHAT_MODEL=openai:gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model's output size or Qdrant rejects the vectors.
EMBEDDING_DIM=1536

# --- vector store -----------------------------------------------------
# Leave QDRANT_URL empty to run in-memory: no server, no setup. That is how
# the tests run and how a fresh clone works with nothing but an OpenAI key.
# Set it to a Qdrant Cloud cluster URL for anything that must persist.
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION=grounded

# --- access control ---------------------------------------------------
# If set, every request except /health needs this as the X-API-Key header.
# Leave empty locally. ALWAYS set it on a public deployment - /ask spends
# money on the OpenAI key above.
API_KEY=

# --- chunking / retrieval ---------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4

# --- server -----------------------------------------------------------
# Hugging Face Spaces probes 7860. Render and Cloud Run inject their own.
PORT=7860
